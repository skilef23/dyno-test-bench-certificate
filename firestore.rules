rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // DEVELOPMENT ONLY: any Firebase-authenticated session, including an
    // anonymous session, may access the shared KRA development workspace.
    // Replace this with employee identity and role claims before production.
    match /organizations/kra-development/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
